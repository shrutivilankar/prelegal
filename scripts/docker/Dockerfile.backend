# syntax=docker/dockerfile:1
# FastAPI backend. Build from the repository root:
#   docker build -f scripts/docker/Dockerfile.backend .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# app.db and app.services.catalog derive the repository root from their own
# location, so catalog.json and templates/ must sit one level above backend/.
COPY catalog.json ./catalog.json
COPY templates ./templates
COPY backend/app ./backend/app

RUN useradd --create-home --uid 10001 prelegal \
    && mkdir -p /app/backend/data \
    && chown -R prelegal:prelegal /app/backend/data
USER prelegal

WORKDIR /app/backend
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
